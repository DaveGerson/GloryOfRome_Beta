{
  "name": "roman-crisis-simulation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:ci": "vitest run --config vitest.eval-ci.config.ts",
    "test:journeys": "vitest run --config vitest.journeys.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify:static": "npm run typecheck && npm run lint",
    "verify:unit": "npm test",
    "verify:integration": "npm run test:journeys && npm run eval:ci && npm run build",
    "verify": "npm run verify:static && npm run verify:unit && npm run verify:integration"
  },
  "dependencies": {
    "@google/genai": "^1.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
